<?php

/**
 * @file
 * Install, update and uninstall functions for the hedley_openmrs module.
 */

/**
 * Implements hook_install().
 */
function hedley_openmrs_install() {
  _hedley_openmrs_create_encounter_uuid_field();
}

/**
 * Creates the field that stores the linked OpenMRS encounter UUID.
 */
function _hedley_openmrs_create_encounter_uuid_field() {
  if (field_info_field('field_openmrs_encounter_uuid')) {
    return;
  }

  field_create_field([
    'field_name' => 'field_openmrs_encounter_uuid',
    'type' => 'text',
    'cardinality' => 1,
    'settings' => ['max_length' => 255],
  ]);

  field_create_instance([
    'field_name' => 'field_openmrs_encounter_uuid',
    'entity_type' => 'node',
    'bundle' => 'prenatal_encounter',
    'label' => 'OpenMRS encounter UUID',
  ]);
}

/**
 * Adds the OpenMRS encounter UUID field to existing installations.
 *
 * The hedley_openmrs module already shipped in Phase 1 and is deployed to
 * existing environments. Those environments have the module enabled but lack
 * this newly introduced field, and the Pantheon deploy runs `updb` rather than
 * a fresh install or `fra`. hook_install() only runs on brand-new installs, so
 * this update hook is what creates the field on already-deployed sites.
 */
function hedley_openmrs_update_7001() {
  _hedley_openmrs_create_encounter_uuid_field();
}

/**
 * Implements hook_uninstall().
 */
function hedley_openmrs_uninstall() {
  if (field_info_field('field_openmrs_encounter_uuid')) {
    field_delete_field('field_openmrs_encounter_uuid');
  }
}
