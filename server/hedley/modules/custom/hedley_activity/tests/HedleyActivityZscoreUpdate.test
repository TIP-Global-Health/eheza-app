<?php

/**
 * @file
 * Contains \HedleyActivityZscoreUpdate.
 */

/**
 * HedleyActivityZscoreUpdate tests.
 */
class HedleyActivityZscoreUpdate extends HedleyWebTestBase {

  /**
   * Info hook.
   */
  public static function getInfo() {
    return [
      'name' => 'HedleyActivityZscoreUpdate tests',
      'description' => 'Tests updating of ZScores.',
      'group' => 'Hedley',
    ];
  }

  /**
   * Test updating ZScores.
   */
  public function testUpdatingZscores() {
    $health_center_id = $this->createHealthCenter();
    $clinic_id = $this->createClinic($health_center_id);
    $mother_id = $this->createMother($clinic_id);
    $child_id = $this->createChild($mother_id);

    // Our default child is born on 2015-06-27, so we'll start out as a 1-year
    // old.
    $one_year_old = strtotime('2016-06-27');
    $session_id = $this->createSession($clinic_id, $one_year_old);

    $weight_id = $this->createWeight('weight', $session_id, $child_id, 13, $one_year_old);
    $weight = entity_metadata_wrapper('node', $weight_id);

    // Check that we have calculated a zscore-age.
    $this->assertEqual(round($weight->field_zscore_age->value(), 2), 2.75);

    // Then, add a height ...
    $height_id = $this->createHeight('height', $session_id, $child_id, 82, $one_year_old);
    $height = entity_metadata_wrapper('node', $height_id);

    // Check that we have a ZScore age.
    $this->assertEqual(round($height->field_zscore_age->value(), 2), 2.62);

    // We should now also have several additional calculations on the weight.
    entity_get_controller('node')->resetCache([$weight_id]);
    $weight = entity_metadata_wrapper('node', $weight_id);

    $this->assertEqual(round($weight->field_bmi->value(), 2), 19.33);
    $this->assertEqual(round($weight->field_zscore_length->value(), 2), 2.14);
    $this->assertEqual(round($weight->field_zscore_bmi->value(), 2), 1.71);

    // If we change the child's birth date, then the zscores should get
    // updated.
    $child = entity_metadata_wrapper('node', $child_id);
    $child->field_birth_date->set(strtotime('2016-01-27'));
    $child->save();

    // Reset.
    entity_get_controller('node')->resetCache([
      $weight_id,
      $height_id,
    ]);

    $weight = entity_metadata_wrapper('node', $weight_id);
    $height = entity_metadata_wrapper('node', $height_id);

    // At five months, 82 cm and 13 kg give 7.63 and 5.48, beyond the WHO
    // limits, so the z-scores are cleared.
    $this->assertNull($height->field_zscore_age->value());
    $this->assertNull($weight->field_zscore_age->value());

    // A weight of 0 was not measured, so it gets no z-score.
    $zero_weight_id = $this->createWeight('weight', $session_id, $child_id, 0, $one_year_old);
    $zero_weight = entity_metadata_wrapper('node', $zero_weight_id);
    $this->assertNull($zero_weight->field_zscore_age->value());

    // Back to a one year old, for the head circumference.
    $child->field_birth_date->set(strtotime('2015-06-27'));
    $child->save();

    $head_circumference_id = $this->createHeadCircumference($child_id, 46, 'none', $one_year_old);
    $head_circumference = entity_metadata_wrapper('node', $head_circumference_id);
    $this->assertEqual(round($head_circumference->field_zscore_age->value(), 2), -0.06);

    // "Not taken" is stored as 0 cm, and gets no z-score.
    $not_taken_id = $this->createHeadCircumference($child_id, 0, 'not-taken', $one_year_old);
    $not_taken = entity_metadata_wrapper('node', $not_taken_id);
    $this->assertNull($not_taken->field_zscore_age->value());
  }

  /**
   * Create a well child head circumference.
   *
   * @param int $child_id
   *   The node ID of the child.
   * @param float $cm
   *   The head circumference.
   * @param string $note
   *   The measurement note: 'none' or 'not-taken'.
   * @param int $timestamp
   *   The date the measurement was taken, as a unix timestamp.
   *
   * @return int
   *   The node ID of the head circumference.
   */
  protected function createHeadCircumference($child_id, $cm, $note, $timestamp) {
    $node = $this->drupalCreateNode(['type' => 'well_child_head_circumference']);

    $wrapper = entity_metadata_wrapper('node', $node);
    $wrapper->field_person->set($child_id);
    $wrapper->field_date_measured->set($timestamp);
    $wrapper->field_head_circumference->set($cm);
    $wrapper->field_measurement_notes->set([$note]);
    $wrapper->save();

    return $node->nid;
  }

}
