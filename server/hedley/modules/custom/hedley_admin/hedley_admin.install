<?php

/**
 * @file
 * Install and update functions.
 */

/**
 * Remove the "Create user" menu.
 */
function hedley_admin_update_7001() {
  db_delete('menu_links')
    ->condition('menu_name', 'menu-eheza-app-admin-menu')
    ->condition('link_path', 'admin/people/create')
    ->execute();
}

/**
 * Remove the Create child, mother and caregiver menus.
 */
function hedley_admin_update_7002() {
  db_delete('menu_links')
    ->condition('menu_name', 'menu-eheza-app-admin-menu')
    ->condition('link_path', 'node/add/mother')
    ->execute();

  db_delete('menu_links')
    ->condition('menu_name', 'menu-eheza-app-admin-menu')
    ->condition('link_path', 'node/add/child')
    ->execute();
}

/**
 * Remove the weekly report recipient, which nothing reads any more.
 *
 * The settings page that offered it is gone too, so rebuild the menu: the
 * router still holds a row for admin/config/hedley-reporting, whose page
 * callback names a form function that no longer exists. Cache flushing at the
 * end of a completed update run would clear it anyway, but an update run that
 * does not reach the end would leave the route live and fatal on request.
 */
function hedley_admin_update_7003() {
  variable_del('hedley_admin_report_email');
  menu_rebuild();
}
